#compdef atra

autoload -U is-at-least

_atra() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--generate=[Generate shell completions]:GENERATOR:(bash elvish fish powershell zsh)' \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_atra_commands" \
"*::: :->atra" \
&& ret=0
    case $state in
    (atra)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:atra-command-$line[1]:"
        case $line[1] in
            (health)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(chat)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':message -- The message to send:_default' \
&& ret=0
;;
(plan)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':goal -- The goal to plan for:_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(cleanup)
_arguments "${_arguments_options[@]}" : \
'--tables=[Tables to clean (comma-separated)]:TABLES:_default' \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'--dry-run[Dry run mode (default\: true)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(describe)
_arguments "${_arguments_options[@]}" : \
'--prompt=[Optional prompt for description]:PROMPT:_default' \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':image_path -- Path to the image file:_files' \
&& ret=0
;;
(apply)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':file_path -- Path to the file to patch:_files' \
':patch -- The patch string containing SEARCH/REPLACE blocks:_default' \
&& ret=0
;;
(git)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_atra__git_commands" \
"*::: :->git" \
&& ret=0

    case $state in
    (git)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:atra-git-command-$line[1]:"
        case $line[1] in
            (status)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(diff)
_arguments "${_arguments_options[@]}" : \
'-p+[]:PATH:_default' \
'--path=[]:PATH:_default' \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(log)
_arguments "${_arguments_options[@]}" : \
'-n+[]:N:_default' \
'--n=[]:N:_default' \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(branch)
_arguments "${_arguments_options[@]}" : \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(commit)
_arguments "${_arguments_options[@]}" : \
'-m+[Commit message]:MESSAGE:_default' \
'--message=[Commit message]:MESSAGE:_default' \
'*-p+[Paths to add (default\: all)]:PATHS:_default' \
'*--paths=[Paths to add (default\: all)]:PATHS:_default' \
'-c+[Config file path]:CONFIG:_files' \
'--config=[Config file path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_atra__git__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:atra-git-help-command-$line[1]:"
        case $line[1] in
            (status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(diff)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(log)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(branch)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(commit)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
