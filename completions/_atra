_atra_commands() {
    local commands; commands=(
'health:Checks connection to Rust API Gateway and Victoria' \
'chat:Sends a message to Victoria through the Gateway' \
'plan:Requests a plan from Victoria' \
'status:Shows system metrics and health' \
'cleanup:Triggers data retention cleanup' \
