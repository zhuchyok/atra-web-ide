{
  "dashboard": {
    "title": "ATRA Knowledge OS Dashboard",
    "uid": "atra-knowledge-os",
    "tags": ["singularity", "ai", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 100,
        "title": "Total Savings ($)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(llm_tokens_total{provider=\"local\", direction=\"input\"}) * 0.000003 + sum(llm_tokens_total{provider=\"local\", direction=\"output\"}) * 0.000015",
            "legendFormat": "Savings",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "mode": "fixed", "fixedColor": "green" },
            "decimals": 2
          }
        }
      },
      {
        "id": 101,
        "title": "ROI %",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
        "targets": [
          {
            "expr": "(sum(llm_tokens_total{provider=\"local\", direction=\"input\"}) * 0.000003 + sum(llm_tokens_total{provider=\"local\", direction=\"output\"}) * 0.000015) / 5000 * 100",
            "legendFormat": "ROI",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "color": { "mode": "continuous-grayscale" }
          }
        }
      },
      {
        "id": 102,
        "title": "Local Autonomy %",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
        "targets": [
          {
            "expr": "sum(llm_requests_total{provider=\"local\"}) / (sum(llm_requests_total) + 1e-9) * 100",
            "legendFormat": "Autonomy",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 80 },
                { "color": "green", "value": 95 }
              ]
            }
          }
        }
      },
      {
        "id": 1,
        "title": "Latency (p50, p95, p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "singularity_latency_seconds{quantile=\"0.5\"}",
            "legendFormat": "p50"
          },
          {
            "expr": "singularity_latency_seconds{quantile=\"0.95\"}",
            "legendFormat": "p95"
          },
          {
            "expr": "singularity_latency_seconds{quantile=\"0.99\"}",
            "legendFormat": "p99"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
      },
      {
        "id": 2,
        "title": "Cache Hit Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "singularity_cache_hit_rate",
            "legendFormat": "Cache Hit Rate"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
      },
      {
        "id": 3,
        "title": "Token Usage and Savings",
        "type": "graph",
        "targets": [
          {
            "expr": "singularity_tokens_saved_total",
            "legendFormat": "Tokens Saved"
          },
          {
            "expr": "singularity_requests_total",
            "legendFormat": "Total Requests"
          },
          {
            "expr": "sum(llm_tokens_total{provider=\"local\"})",
            "legendFormat": "Local Tokens",
            "refId": "C"
          },
          {
            "expr": "sum(llm_tokens_total{provider=\"cloud\"})",
            "legendFormat": "Cloud Tokens",
            "refId": "D"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "singularity_error_rate",
            "legendFormat": "Error Rate"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
      },
      {
        "id": 5,
        "title": "Requests Per Minute",
        "type": "graph",
        "targets": [
          {
            "expr": "singularity_requests_per_minute",
            "legendFormat": "Requests/min"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }
      },
      {
        "id": 200,
        "title": "RAM vs Swap Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
            "legendFormat": "RAM Used",
            "refId": "A"
          },
          {
            "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
            "legendFormat": "Swap Used",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      }
    ],
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1,
    "id": null
  },
  "overwrite": true
}
