# Шаблон переменных окружения для Knowledge OS
# Скопировать в .env и задать значения. Секреты (пароли, токены) не коммитить.
# В проде — использовать секрет-менеджер (Vault, облако).

# Mac Docker Desktop: absolute host path to this repo (required for dynamic worker
# recreate / sandbox-* via docker.sock from inside orchestrator). Example:
# HOST_PROJECT_ROOT=/Users/you/Documents/atra-web-ide
# HOST_SANDBOX_SHARED_DIR=/Users/you/Documents/atra-web-ide/knowledge_os/sandbox_shared

# База данных
# POSTGRES_PASSWORD=your-secure-password

# OpenAI API (опционально, для облачных моделей)
# OPENAI_API_KEY=your-api-key

# WebUI secret key (опционально)
# WEBUI_SECRET_KEY=your-secure-secret
