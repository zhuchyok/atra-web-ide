#!/usr/bin/expect -f

set timeout 60
set server "185.177.216.15"
set user "root"
set password "u44Ww9NmtQj,XG"

spawn ssh ${user}@${server}

expect {
    "password:" {
        send "${password}\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "${password}\r"
    }
}

expect "# "
send "cd /root/atra\r"
expect "# "

send "echo '=== ПОЛНАЯ ДИАГНОСТИКА ==='\r"
expect "# "

send "echo '1. Все блокировки за последний час:'\r"
expect "# "
send "grep -E 'BLOCK|🚫' bot_startup.log 2>/dev/null | tail -50\r"
expect "# "

send "echo '2. Все прохождения фильтров:'\r"
expect "# "
send "grep -E 'PASS|✅.*PASS' bot_startup.log 2>/dev/null | tail -30\r"
expect "# "

send "echo '3. Статистика блокировок по типам:'\r"
expect "# "
send "grep -E 'BLOCK|🚫' bot_startup.log 2>/dev/null | grep -oE '(BLOCK|🚫).*' | sed 's/.*\\[\\(.*\\)\\].*/\\1/' | sort | uniq -c | sort -rn\r"
expect "# "

send "echo '4. Примеры сигналов, которые прошли все фильтры:'\r"
expect "# "
send "grep -B 5 -A 5 'QUALITY PASS.*VOLUME PASS.*BREAKOUT PASS' bot_startup.log 2>/dev/null | tail -40\r"
expect "# "

send "echo '5. Проверка ликвидности:'\r"
expect "# "
send "grep -E 'Ликвидность|ликвидность' bot_startup.log 2>/dev/null | tail -20\r"
expect "# "

send "echo '6. Проверка Quality и Confidence:'\r"
expect "# "
send "grep -E 'Quality.*Confidence|QUALITY CHECK' bot_startup.log 2>/dev/null | tail -20\r"
expect "# "

send "echo '7. Последние 60 строк лога:'\r"
expect "# "
send "tail -60 bot_startup.log\r"
expect "# "

send "exit\r"
expect eof
