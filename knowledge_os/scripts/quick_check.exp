#!/usr/bin/expect -f

set timeout 30
set server "185.177.216.15"
set user "root"
set password "u44Ww9NmtQj,XG"

spawn ssh ${user}@${server}

expect {
    "password:" {
        send "${password}\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "${password}\r"
    }
}

expect "# "
send "cd /root/atra\r"
expect "# "

send "echo '=== БЫСТРАЯ ПРОВЕРКА ==='\r"
expect "# "

send "echo '1. Сигналы (последние 30 строк):'\r"
expect "# "
send "grep -i 'signal\|LONG\|SHORT' bot_startup.log 2>/dev/null | tail -30\r"
expect "# "

send "echo '2. Блокировки (последние 20):'\r"
expect "# "
send "grep -i 'block\|🚫' bot_startup.log 2>/dev/null | tail -20\r"
expect "# "

send "echo '3. Ликвидность (последние 10):'\r"
expect "# "
send "grep -i 'ликвидность' bot_startup.log 2>/dev/null | tail -10\r"
expect "# "

send "echo '4. Последние 40 строк лога:'\r"
expect "# "
send "tail -40 bot_startup.log\r"
expect "# "

send "exit\r"
expect eof
