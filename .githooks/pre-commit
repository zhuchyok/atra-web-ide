#!/bin/sh
# ATRA Web IDE Pre-commit Hook (Combined)
# 1. Existing custom logic (employees.json sync)
# 2. Pre-commit framework (ruff, prettier, detect-secrets)

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# STEP 1: Custom logic - employees.json sync
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if git diff --cached --name-only | grep -q 'configs/experts/employees.json'; then
  echo "[pre-commit] configs/experts/employees.json изменён — запуск sync_employees.py..."
  if ! python3 scripts/sync_employees.py; then
    echo "[pre-commit] Ошибка sync_employees.py. Коммит отменён."
    exit 1
  fi
  git add configs/experts/_known_names_generated.py knowledge_os/db/seed_experts.json configs/experts/employees.md
  echo "[pre-commit] Добавлены в коммит: _known_names_generated.py, seed_experts.json, employees.md"
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# STEP 2: Local Git-Guardian (AI Pre-commit Auditor)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo "[pre-commit] Запуск Local Git-Guardian (Victoria AI Audit)..."
export PYTHONPATH="$PYTHONPATH:$ROOT/knowledge_os/app:$ROOT/knowledge_os"
# Загружаем .env чтобы RUST_GATEWAY_URL и другие переменные были доступны на хосте
if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ROOT/.env" 2>/dev/null || true
  set +a
fi
if ! $ROOT/knowledge_os/.venv/bin/python scripts/git_guardian.py; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "❌ AI Audit failed! Commit rejected by Victoria."
  echo "   Fix the issues or use 'git commit --no-verify' if you are sure."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 1
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# STEP 3: Pre-commit framework (ruff, prettier, security)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Check if pre-commit is installed
if command -v pre-commit >/dev/null 2>&1; then
    echo "[pre-commit] Running pre-commit hooks (ruff, prettier, detect-secrets)..."
    # Run pre-commit on staged files only
    if ! pre-commit run --config .pre-commit-config.yaml; then
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ Pre-commit checks failed!"
        echo "   Run 'pre-commit run --all-files' to see all issues"
        echo "   or 'git commit --no-verify' to skip (not recommended)"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        exit 1
    fi
else
    echo "[pre-commit] WARNING: pre-commit not installed, skipping framework checks"
    echo "           Install with: brew install pre-commit"
fi

echo "✅ All pre-commit checks passed!"
exit 0
