# Шаблон переменных окружения для ATRA Web IDE (корень репо)
# Скопировать в .env и задать значения. Секреты (пароли, токены) не коммитить.
# В проде — использовать секрет-менеджер (Vault, облако). См. docs/VERIFICATION_CHECKLIST_OPTIMIZATIONS.md §5.

# Проект и агенты
PROJECT_NAME=atra-web-ide
MAIN_PROJECT=atra-web-ide
VICTORIA_URL=http://localhost:8010
VERONICA_URL=http://localhost:8011
KNOWLEDGE_OS_API_URL=http://localhost:8002
BACKEND_URL=http://localhost:8080

# LLM (Ollama / MLX на хосте)
OLLAMA_URL=http://localhost:11434
# MLX_API_URL=http://localhost:11435
# Rust Gateway RAG (порт 8081 на хосте; внутри Docker — https://atra-web-ide-gateway:8081)
# Без этой переменной pre-commit хук и host-процессы падают с DNS ошибкой на docker-internal имени
RUST_GATEWAY_URL=https://localhost:8081/api/knowledge/search_v2

# Ollama: сколько держать модель в памяти после запроса (executor, LocalAIRouter). См. docs/MODEL_UNLOADING_AND_MEMORY.md
# Не задано — дефолт Ollama (~5 мин). 0 — выгрузить сразу (экономия памяти, холодный старт). 300 или 5m — держать N с/мин.
# VICTORIA_OLLAMA_KEEP_ALIVE=300
# OLLAMA_KEEP_ALIVE=0

# Backend: лимит слотов Victoria
MAX_CONCURRENT_VICTORIA=50

# БД (значение по умолчанию для разработки; в проде — из секретов)
# DATABASE_URL=postgresql://user:password@host:5432/knowledge_os

# Victoria: модель и уровни (опционально)
# VICTORIA_MODEL=phi3.5:3.8b
# USE_VICTORIA_ENHANCED=true
# ENABLE_EVENT_MONITORING=true

# Строго локальный режим: без fallback на cursor-agent/облако. По умолчанию false (рекомендуется).
# STRICT_LOCAL подходит для полной автономности (closed network, конфиденциальные данные),
# но снижает качество на сложных задачах. Используйте при необходимости изоляции от внешних API.
# ВАЖНО: Перед включением выполните pre-flight checklist (см. docs/MASTER_REFERENCE.md, раздел STRICT_LOCAL):
#   1. Проверьте доступность MLX: curl -s http://localhost:11435/health → 200
#   2. Проверьте доступность Ollama: curl -s http://localhost:11434/api/tags → 200
#   3. Проверьте Recovery Listener: curl -s http://localhost:9099/recover → 200
# При изменении STRICT_LOCAL перезапустите контейнеры: docker-compose -f knowledge_os/docker-compose.yml up -d
STRICT_LOCAL=false

# Логика мысли (план PLAN_REASONING_LOGIC_VICTORIA): стратегия ответа
# VICTORIA_STRATEGY_ENABLED=true
# STRATEGY_CACHE_TTL_SEC=120

# Долгосрочная память по пользователю/проекту (Фаза 2)
# LONG_TERM_MEMORY_ENABLED=false
# LONG_TERM_MEMORY_TTL_DAYS=7
# LONG_TERM_MEMORY_MAX_THREADS=20

# Рефлексия и пересмотр плана (Фаза 3, ReCAP)
# VICTORIA_REFLECTION_ENABLED=true
# VICTORIA_MAX_PLAN_REVISIONS=1

# Telegram (опционально; токены — только из env/секретов, не коммитить)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_ID=

# Рабочий каталог
# WORKSPACE_ROOT=/workspace

# --- VDS: вход в личный кабинет Сетки 21 (atra-core) ---
# На сервере в /home/atra/app/.env задать и перезапустить: docker-compose up -d atra-core
# AUTH_ADMIN_EMAIL=admin@setki21.ru
# AUTH_ADMIN_PASSWORD=надёжный_пароль

# --- VDS: moskit-api (API Сетки 21: цены, админка) ---
# После деплоя moskit-api вход: admin@setki21.ru и тот же AUTH_ADMIN_PASSWORD (миграция 004).
# MOSKIT_DB_PASSWORD=секрет_для_пользователя_БД_moskit
# JWT_SECRET=секрет_для_JWT_токенов_админки

# RAG (Victoria: скорость vs полнота контекста). См. docs/RAG_PLUS_ROCKET_SPEED.md
# Меньше значений — быстрее первый токен; больше — полнее контекст для ответа.
# RAG_CONTEXT_LIMIT=3
# RAG_SNIPPET_CHARS=300

# RAG-кэш в Redis (при масштабировании — несколько инстансов Victoria). См. NEXT_STEPS_CORPORATION.md §2.
# RAG_CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379

# MLX Dual-Channel Brain Configuration
MLX_MAX_CACHED_MODELS=5
MLX_MAX_CONCURRENT=1
MLX_SPECULATIVE_DECODING=false
MLX_PRELOAD_MODELS=fast,coding,victoria-wisdom-v3.5
